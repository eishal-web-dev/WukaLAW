# WakuLaw environment variables — copy to .env and adjust. Never commit .env.

# ---- Backend (apps/api) ----
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./wakulaw.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# ---- Auth ----
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_EXPIRE_HOURS=168

# ---- AI ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=./storage/faiss.index
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=wakulaw_legal_chunks
QDRANT_TIMEOUT=30
QDRANT_PREFER_GRPC=false
QDRANT_LOCAL_PATH=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ---- Frontend (apps/web) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1

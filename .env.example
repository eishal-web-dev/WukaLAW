# WakuLaw environment variables — copy to .env and adjust. Never commit .env.

# ---- Backend (apps/api) ----
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./wakulaw.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# ---- Auth ----
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_EXPIRE_HOURS=168

# ---- AI / embeddings ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=wakulaw_legal_chunks
UPLOAD_QDRANT_COLLECTION=wakulaw_user_documents
QDRANT_TIMEOUT=30
QDRANT_PREFER_GRPC=false
# For local embedded Qdrant only. Leave blank when using a Qdrant server/cloud.
QDRANT_LOCAL_PATH=

# ---- AWS S3 private document storage ----
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_PRESIGN_EXPIRY_SECONDS=900
# Normally leave blank. Useful only for LocalStack/MinIO development.
AWS_S3_ENDPOINT_URL=
# Local development may use these standard boto3 variables. In ECS/Fargate use
# an IAM task role instead of long-lived access keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- RAG LLM ----
RAG_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ---- Frontend (apps/web) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
# local = current multipart upload; s3 = browser uploads directly with presigned PUT URL
VITE_UPLOAD_MODE=local

# WakuLaw environment variables — copy to .env and adjust. Never commit .env.

# ---- Backend (apps/api) ----
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./wakulaw.db
UPLOAD_DIR=./uploads
# Local multipart fallback stays small; direct object-storage upload supports large books.
MAX_UPLOAD_MB=20
MAX_S3_UPLOAD_MB=512

# ---- Auth ----
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_EXPIRE_HOURS=168

# ---- AI / embeddings ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=wakulaw_real_5000
UPLOAD_QDRANT_COLLECTION=wakulaw_user_documents
QDRANT_TIMEOUT=30
QDRANT_PREFER_GRPC=false
# For local embedded Qdrant only. Relative paths are resolved from the WakuLAW repo root.
QDRANT_LOCAL_PATH=datasets/processed/qdrant_real_5000

# ---- S3-compatible private document storage ----
# Cloudflare R2 (recommended for current deployment):
#   AWS_REGION=auto
#   AWS_S3_ENDPOINT_URL=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
#   AWS_S3_BUCKET=wakulaw-storage
#   AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
#   AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# AWS S3 also works: use the AWS region and leave AWS_S3_ENDPOINT_URL blank.

# ---- RAG LLM ----
RAG_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ---- Retrieval quality (see docs/STRATIFIED_RETRIEVAL_REPORT.md) ----
# RETRIEVAL_MODE=dense (default) keeps today's plain dense-only Qdrant
# retrieval. RETRIEVAL_MODE=hybrid fuses it with a lexical relevance score
# computed over the retrieved candidate pool (issue #47) — the stratified
# eval found a lexical baseline beating dense-only at every cutoff.
RETRIEVAL_MODE=dense
RETRIEVAL_HYBRID_DENSE_WEIGHT=0.6
# RAG_RERANKER=lexical|cross_encoder|none (default) adds a reranking pass
# (issue #46) on top of whichever RETRIEVAL_MODE selected. 'lexical' is
# free/offline; 'cross_encoder' needs sentence-transformers + network/cache
# access to download CROSS_ENCODER_MODEL on first use.
RAG_RERANKER=none
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base

# ---- Frontend (apps/web) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
# local = multipart through FastAPI; s3 = direct presigned PUT to AWS S3 / Cloudflare R2
VITE_UPLOAD_MODE=s3
AWS_S3_BUCKET=wakulaw-documents
AWS_S3_ENDPOINT_URL=<YOUR_S3_OR_R2_OR_SUPABASE_ENDPOINT>
AWS_REGION=ap-southeast-2

AWS_ACCESS_KEY_ID=<YOUR_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_SECRET_ACCESS_KEY>

AWS_PRESIGN_EXPIRY_SECONDS=900
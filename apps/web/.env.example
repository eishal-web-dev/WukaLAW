# Optional public URL of the wukaLAW API. Leave blank for local development;
# Vite proxies /api requests to VITE_DEV_API_TARGET.
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# local = multipart upload through FastAPI
# s3 = direct browser -> private S3 using a presigned URL
VITE_UPLOAD_MODE=local


# Lemon Squeezy hosted checkout URLs. Use the fallback for one shared checkout,
# or set a separate checkout URL for each plan.
VITE_LEMONSQUEEZY_CHECKOUT_URL=
VITE_LEMONSQUEEZY_STARTER_URL=
VITE_LEMONSQUEEZY_PRO_URL=
VITE_LEMONSQUEEZY_FIRM_URL=
